#!/usr/bin/env bash
#
# This repository is PUBLIC. Belt-and-suspenders: re-run the leak scan on the range being
# pushed, so anything that slipped past pre-commit (e.g. a --no-verify commit) does not
# leave the machine. Reads the standard pre-push stdin: <localref> <localsha> <remoteref> <remotesha>.
#
# Bypass (discouraged): git push --no-verify
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$ZERO" ] && continue                       # branch deletion — nothing to scan
  base="$rsha"; [ "$rsha" = "$ZERO" ] && base="$EMPTY_TREE"  # new branch: scan all added lines
  "$ROOT/.githooks/leak-scan.sh" "$base" "$lsha" || status=1
done
[ "$status" -ne 0 ] && { echo "  push blocked — leak scan failed (see above)." >&2; exit 1; }
exit 0
