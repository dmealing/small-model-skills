#!/usr/bin/env bash
# net-diag — read-only local + LAN + DNS + internet triage. Config-driven; changes nothing.
# Exit: 0 diagnosis ran (even if it found a problem), 1 tool itself failed.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; . "$BIN_DIR/lib/common.sh"

smols_identity "Read-only snapshot: local link/DNS/internet reachability"

links="$(smols_local_links | sort -k2,2r | head -8 | awk '{printf "%s,%s\n",$1,$2}')"
if [ -z "$links" ] && [ -z "$(smols_host_addr)" ]; then
  smols_verdict FAIL PROBE_FAILED "could not enumerate any network interface on this system"
  smols_help "Check that this OS is supported (SMOLS_OS=$SMOLS_OS) and that ip/ifconfig are available"
  exit 1
fi

smols_sec "local link"
printf '%s\n' "$links" | smols_toon links iface,state

smols_sec "addressing"
smols_line "host address" "$(smols_host_addr)"
smols_line "default gateway" "${GATEWAY_IP:-<unknown>}"

smols_sec "reachability"
if [ -n "$GATEWAY_IP" ] && smols_ping "$GATEWAY_IP"; then GWS=reachable; else GWS=UNREACHABLE; fi
smols_line "gateway ${GATEWAY_IP:-<unknown>}" "$GWS"
NET=FAIL
for t in "$DNS_PUBLIC" "$DNS_PUBLIC2"; do [ -n "$t" ] && smols_ping "$t" && { NET=PASS; break; }; done
smols_line "internet (raw IP)" "$NET   (ping $DNS_PUBLIC, bypasses DNS)"

smols_sec "dns"
DNS_L=skip
if [ -n "$DNS_LOCAL" ]; then
  if have dig; then DNS_L=FAIL; dig +short +time=1 +tries=1 cloudflare.com @"$DNS_LOCAL" 2>/dev/null | grep -qE '[0-9]' && DNS_L=PASS
  else DNS_L="skip (dig not installed)"; fi
fi
if have dig; then DNS_P=FAIL; dig +short +time=1 +tries=1 cloudflare.com @"$DNS_PUBLIC" 2>/dev/null | grep -qE '[0-9]' && DNS_P=PASS
else DNS_P="skip (dig not installed)"; fi
DNS_S=FAIL; smols_resolve_system cloudflare.com && DNS_S=PASS
[ "$DNS_L" != skip ] && smols_line "via local DNS $DNS_LOCAL" "$DNS_L"
smols_line "via public $DNS_PUBLIC" "$DNS_P"
smols_line "via system resolver" "$DNS_S"

smols_sec "verdict"
if [ "$GWS" != reachable ]; then
  smols_verdict FAIL GATEWAY_UNREACHABLE "gateway unreachable -> check cable/Wi-Fi/switch. Not an ISP problem."
  smols_help "Check the physical/Wi-Fi connection, then re-run net-diag"
elif [ "$NET" = FAIL ]; then
  smols_verdict FAIL INTERNET_DOWN "gateway OK but no internet -> likely an ISP/WAN outage or failover. Next: run 'router-status'."
  smols_help "Run 'router-status' for WAN/failover detail"
elif [ "$DNS_L" = FAIL ] && [ "$DNS_P" = PASS ]; then
  smols_verdict WARN DNS_LOCAL "internet is up but local DNS ($DNS_LOCAL) is not resolving -> check your local DNS server."
  smols_help "Check the local DNS server ($DNS_LOCAL) is running and reachable"
elif [ "$DNS_S" = FAIL ]; then
  if [ "$SMOLS_OS" = macos ]; then
    smols_verdict WARN DNS_SYSTEM "resolvers reachable but system resolution failing -> check System Settings > Network > DNS, or 'sudo dscacheutil -flushcache'."
    smols_help "Check System Settings > Network > DNS servers, then 'sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder'"
  else
    smols_verdict WARN DNS_SYSTEM "resolvers reachable but system resolution failing -> check /etc/resolv.conf / systemd-resolved."
    smols_help "Check /etc/resolv.conf and 'systemctl status systemd-resolved'"
  fi
else
  smols_verdict OK NOMINAL "local link, gateway, internet, and DNS all OK."
fi
exit 0
