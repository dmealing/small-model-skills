#!/usr/bin/env bash
# disk-report — read-only "what's using my disk?" analysis. Never deletes anything.
# Exit: 0 diagnosis ran (even if it found a problem), 1 tool itself failed.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; . "$BIN_DIR/lib/common.sh"

sms_identity "Read-only disk-space snapshot: filesystems/biggest dirs/common hogs. Proposes cleanup, never deletes."

fs="$(sms_df)"
if [ -z "$fs" ]; then
  echo "verdict: FAILED — could not read filesystem usage on this system"
  sms_help "Check that this OS is supported (SMS_OS=$SMS_OS) and that df is available"
  exit 1
fi

sms_sec "filesystems"
printf '%s\n' "$fs" | awk 'NR==1||/%/{print "  "$0}' | head -14

target=$(sms_df_fullest)
target="${target:-/}"
sms_sec "biggest dirs one level under $target"
sms_du_top1 "$target" | sort -rh -k1 | head -12 \
  | awk '{sz=$1; $1=""; sub(/^ /,""); printf "%s,%s\n",sz,$0}' | sms_toon dirs size,path

sms_sec "common space hogs"
hog_rows=""
for d in /var/log "$HOME/.cache" /var/cache /var/lib/docker /tmp; do
  [ -d "$d" ] && hog_rows="${hog_rows}$(sms_du_summary "$d"),$d
"
done
printf '%s' "$hog_rows" | grep -v '^$' | sms_toon common_hogs size,path
have docker && sms_line "docker reclaimable" "$(docker system df 2>/dev/null | awk '/^Images|^Containers|^Local/{printf "%s=%s(%s) ",$1,$(NF-1),$NF}')"

sms_sec "verdict"
echo "  Space concentration is shown above. Safe things a human can reclaim after confirming:"
sms_help \
  "package caches: sudo apt clean | pip cache purge | npm cache clean --force | brew cleanup" \
  "journal/log vacuuming: sudo journalctl --vacuum-size=200M (Linux) or manage /var/log manually (macOS)" \
  "docker (confirm first): docker system prune   (removes UNUSED images/containers/networks)" \
  "biggest files: find \"$target\" -xdev -type f -size +100M -exec ls -lh {} \; 2>/dev/null | sort -k5 -rh | head"
echo "  Do NOT delete anything the user has not confirmed is safe."
exit 0
