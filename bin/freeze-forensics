#!/usr/bin/env bash
# freeze-forensics — read-only reconstruction of the LAST hard freeze / unclean reboot, plus a check
# that the anti-freeze mitigations are still armed (watchdog claimed, kernel cmdline flags intact).
# Linux/WSL-primary; on macOS it degrades to reading panic reports. Changes nothing.
# Exit: 0 ran (even if it found a freeze trace), 1 couldn't read any boot history.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; . "$BIN_DIR/lib/common.sh"

smols_identity "Read-only: last-freeze forensics + whether the watchdog / anti-freeze mitigations are still armed"

smols_sec "boots"
boots="$(smols_boot_list)"
if [ -z "$boots" ] && [ "$SMOLS_OS" != macos ]; then
  smols_verdict FAIL PROBE_FAILED "no boot history (journalctl unavailable or no persistent journal)"
  smols_help "Set Storage=persistent in /etc/systemd/journald.conf so future freezes are captured across reboots"
  exit 1
fi
printf '%s\n' "$boots" | tail -6 | sed 's/^/  /'
nboots="$(printf '%s\n' "$boots" | grep -c .)"

smols_sec "previous boot — did it end cleanly?"
smols_prev_boot_clean; pc=$?
case "$pc" in
  0) smols_line "prev shutdown" "CLEAN — the last session logged a normal shutdown/reboot" ;;
  1) smols_line "prev shutdown" "ABRUPT — no clean-shutdown marker (freeze, panic, or power loss)" ;;
  *) smols_line "prev shutdown" "unknown (can't determine on this system)" ;;
esac
rr="$(smols_reset_reason)"; [ -n "$rr" ] && smols_line "reset reason" "$rr"
panic=0; case "$rr" in *"panic report"*) panic=1 ;; esac

if [ "$pc" != 0 ]; then
  ktail="$(smols_prev_boot_kernel_tail 30 | tail -12)"
  if [ -n "$ktail" ]; then
    smols_sec "previous boot — last kernel lines / panic report (look for the freeze signature)"
    printf '%s\n' "$ktail" | sed 's/^/  /'
  fi
fi

smols_sec "hardware errors"
mce="$(smols_mce_summary)"; printf '%s\n' "${mce:-(none found)}" | head -6 | sed 's/^/  /'

smols_sec "watchdog (auto-reboot on freeze) — is it actually armed?"
wd="$(smols_watchdog_status)"; smols_line "watchdog" "$wd"
case "$wd" in
  *device=none*) smols_help "No /dev/watchdog exists — a freeze will hang indefinitely instead of auto-rebooting. Arm a hardware watchdog (e.g. sp5100_tco/iTCO) or systemd RuntimeWatchdogSec." ;;
  *armed=no*)    smols_help "A /dev/watchdog exists but nothing appears to be petting it (RuntimeWatchdogSec unset, no watchdog daemon) — a freeze may NOT auto-reboot. Arm it via RuntimeWatchdogSec= in /etc/systemd/system.conf or a watchdog daemon." ;;
esac

smols_sec "mitigations / kernel"
kern="$(uname -r 2>/dev/null)"; smols_line "running kernel" "${kern:-?}"
cmd="$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | grep -iE 'cgroup_disable|mitigations|nowatchdog|pcie_aspm|amd_iommu|nomodeset' | paste -sd' ' -)"
smols_line "notable cmdline" "${cmd:-<none>}"
for kb in $KNOWN_BAD_KERNELS; do
  case "$kern" in *"$kb"*) echo "  WARNING: running kernel matches a known-bad entry from config ($kb)";; esac
done

if [ -n "$FREEZE_REMOTE_LOG_CMD" ]; then
  smols_sec "remote black-box log"
  # FREEZE_REMOTE_LOG_CMD is config-supplied and executed as code (the one place config is eval'd,
  # not read as data). It is typically an ssh to a log host that is unreachable during the very
  # freeze you're investigating, so cap it hard — an unbounded ssh would hang this probe for the
  # TCP timeout. Set a low ConnectTimeout in the command itself too (see config.example).
  smols_timeout 10 bash -c "$FREEZE_REMOTE_LOG_CMD" 2>/dev/null | tail -15 | sed 's/^/  /' || echo "  (remote log command failed or timed out)"
fi

smols_sec "verdict"
if [ "$pc" = 1 ]; then
  smols_verdict WARN FREEZE_ABRUPT "last session ended abruptly — treat it as a freeze/panic. The kernel tail + hardware errors above are the best clues."
  smols_help "Match the kernel tail to a known signature, and confirm the watchdog line above shows armed=yes so the NEXT freeze auto-reboots"
elif [ "$pc" = 0 ]; then
  smols_verdict OK NOMINAL "no freeze on record — the last shutdown was clean."
  smols_help "Good moment to confirm the watchdog line above shows armed=yes (something is actually petting it)"
elif [ "${panic:-0}" = 1 ]; then
  smols_verdict WARN FREEZE_PANIC "last shutdown was NOT clean; a kernel panic is on record (the panic report + kernel tail above are the definitive evidence)."
  smols_help "Match the panic report / kernel tail above to a known signature; the reset-reason line points at the exact .panic file to open"
elif [ "${nboots:-0}" -le 1 ]; then
  smols_verdict OK LIMITED_HISTORY "only the current boot is in the journal, so the previous session can't be reconstructed here."
  smols_help "Enable a persistent journal and/or a netconsole black-box (FREEZE_REMOTE_LOG_CMD) to capture the next freeze; the watchdog + cmdline mitigations above still show whether you're protected right now"
else
  smols_verdict OK INCONCLUSIVE "couldn't classify the last shutdown; review the sections above."
fi
exit 0
