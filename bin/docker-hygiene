#!/usr/bin/env bash
# docker-hygiene — read-only report of Docker disk waste: orphan anonymous volumes, dead/exited
# containers, dangling images, and reclaimable build cache — while SPARING compose-managed data.
# Proposes prunes; runs nothing. Exit: 0 ran (even if Docker is absent/down).
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; . "$BIN_DIR/lib/common.sh"

smols_identity "Read-only: Docker disk waste — orphan volumes, dead containers, dangling images, build cache"

DKT="${SMOLS_DOCKER_TIMEOUT:-8}"   # cap every docker call — a wedged daemon must not hang the report
if ! have docker; then smols_verdict OK NO_DOCKER "Docker not installed — nothing to report."; exit 0; fi
if ! smols_timeout "$DKT" docker info >/dev/null 2>&1; then
  smols_verdict FAIL DAEMON_DOWN "Docker is installed but the daemon isn't responding (or is wedged past ${DKT}s)."
  smols_help "Start Docker ('systemctl start docker' or launch Docker Desktop), then re-run"; exit 0
fi

smols_sec "disk usage"
smols_line "data root" "$(smols_timeout "$DKT" docker info -f '{{.DockerRootDir}}' 2>/dev/null)"
smols_timeout "$DKT" docker system df 2>/dev/null | sed 's/^/  /'

smols_sec "orphan anonymous volumes (compose-managed data is spared)"
orphans=0
while read -r v; do
  [ -n "$v" ] || continue
  proj="$(smols_timeout "$DKT" docker volume inspect "$v" -f '{{ index .Labels "com.docker.compose.project" }}' 2>/dev/null)"
  { [ -n "$proj" ] && [ "$proj" != "<no value>" ]; } && continue   # compose-managed -> leave it
  echo "  $v"; orphans=$((orphans+1))
done < <(smols_timeout "$DKT" docker volume ls -qf dangling=true 2>/dev/null)
[ "$orphans" -eq 0 ] && echo "  (none)"

smols_sec "dead / exited containers"
dead="$(smols_timeout "$DKT" docker ps -aq --filter status=exited --filter status=dead 2>/dev/null | grep -c .)"
smols_line "count" "$dead"
smols_timeout "$DKT" docker ps -a --filter status=exited --filter status=dead --format '  {{.Names}}  ({{.Image}} — {{.Status}})' 2>/dev/null | head -8

smols_sec "dangling images"
dang="$(smols_timeout "$DKT" docker images -qf dangling=true 2>/dev/null | grep -c .)"
smols_line "count" "$dang"

smols_sec "verdict"
bcache="$(smols_timeout "$DKT" docker system df --format '{{.Type}}|{{.Reclaimable}}' 2>/dev/null | awk -F'|' '$1=="Build Cache"{print $2; exit}')"
bcache="${bcache%% (*}"
bcache_has="$(printf '%s' "$bcache" | awk '{print (($0+0)>0)?1:0}')"
if [ "$orphans" -gt 0 ] || [ "${dead:-0}" -gt 0 ] || [ "${dang:-0}" -gt 0 ] || [ "${bcache_has:-0}" -eq 1 ]; then
  smols_verdict WARN RECLAIMABLE "$orphans orphan volume(s), ${dead:-0} dead container(s), ${dang:-0} dangling image(s), ${bcache:-0B} build cache."
  hints=("Review first (these delete data): 'docker container prune' + 'docker image prune'; remove the listed orphan volumes with 'docker volume rm <name>'. Do NOT 'docker volume prune' blindly — check labels first.")
  [ "${bcache_has:-0}" -eq 1 ] && hints+=("'docker builder prune' reclaims the ${bcache} build cache (see 'docker system df' above)")
  smols_help "${hints[@]}"
else
  smols_verdict OK CLEAN "no orphan volumes, dead containers, dangling images, or reclaimable build cache."
fi
exit 0
