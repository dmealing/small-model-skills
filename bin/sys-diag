#!/usr/bin/env bash
# sys-diag — read-only "why is my computer slow?" snapshot (CPU/load/memory/top hogs/thermal).
# Changes nothing. Exit: 0 diagnosis ran (even if it found a problem), 1 tool itself failed.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; . "$BIN_DIR/lib/common.sh"

ncpu=$(sms_nproc)
load1=$(sms_loadavg)
mem="$(sms_meminfo)"

sms_identity "Read-only snapshot: CPU/load/memory/top processes/thermal"

if [ -z "$load1" ] && [ -z "$mem" ]; then
  echo "verdict: FAILED — could not read load average or memory info on this system"
  sms_help "Check that this OS is supported (SMS_OS=$SMS_OS) and that /proc or sysctl/vm_stat are readable"
  exit 1
fi

sms_sec "load / cpu"
sms_line "uptime" "$(uptime 2>/dev/null | sed 's/.*up /up /')"
sms_line "load(1m) vs cores" "${load1:-?} / $ncpu"

sms_sec "memory"
printf '%s\n' "$mem" | sed 's/^/  /'

sms_sec "top CPU processes"
sms_top_procs_cpu 5 | sms_ps_rows | sms_toon procs_cpu pid,comm,cpu,mem

sms_sec "top memory processes"
sms_top_procs_mem 5 | sms_ps_rows | sms_toon procs_mem pid,comm,mem,cpu

sms_sec "thermal / gpu"
if [ "$SMS_OS" = macos ]; then
  echo "  (thermal read requires 'sudo powermetrics' — not run automatically)"
elif have sensors; then
  sensors 2>/dev/null | grep -iE 'Tctl|Package id|Composite|Tccd|fan' | head -4 | sed 's/^/  /'
else
  echo "  (lm-sensors not installed)"
fi
have nvidia-smi && sms_line "gpu util/mem/temp" "$(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu --format=csv,noheader 2>/dev/null | head -1)"

sms_sec "verdict"
hi=$(sms_top_cpu_pct | awk '{print $1}' | cut -d. -f1)
swapused=$(sms_swap_used_kb)
if [ -n "$load1" ] && awk -v l="$load1" -v c="$ncpu" 'BEGIN{exit !(l > c*1.5)}'; then
  echo "  HIGH LOAD: 1-min load ($load1) well above core count ($ncpu) -> something is saturating the CPU (see top CPU processes)."
  sms_help "Inspect the top CPU process above; stop it if it's safe to, or let it finish if expected"
elif [ "${hi:-0}" -ge 90 ] 2>/dev/null; then
  echo "  CPU HOG: one process is using ~${hi}% of a core (see top CPU processes)."
  sms_help "Inspect the top CPU process above; if it's stuck/runaway, stop and restart it"
elif [ "${swapused:-0}" -gt 1048576 ] 2>/dev/null; then
  echo "  MEMORY PRESSURE: heavy swap in use -> RAM may be exhausted (see top memory processes)."
  sms_help "Close or restart the top memory process above, or add RAM/reduce concurrent workloads"
else
  if have iostat; then io="Run 'iostat -x 2' for disk I/O detail"; else io="Install sysstat for iostat, or profile one app, to check disk I/O"; fi
  echo "  Nominal: load, memory, and per-process usage look normal. If it still feels slow, suspect disk I/O."
  sms_help "$io"
fi
exit 0
