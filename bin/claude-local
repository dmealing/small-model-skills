#!/usr/bin/env bash
# claude-local — run Claude Code against a local Ollama model, fully offline.
# Usage: claude-local [<ollama model tag>] [-- claude args...]
#   No arg -> $CLAUDE_LOCAL_MODEL env, else LOCAL_MODEL_DEFAULT from config, else qwen3-coder-cc.
#   A tag  -> used as the Ollama model (e.g. `claude-local qwen2.5-coder:14b`).
# Any capable ~30B-class MoE coder model works; qwen3-coder-cc is the tested default. A 70B local load is a
# real resource risk, so there's no shortcut — pass the full tag explicitly if you want one.
set -euo pipefail

SMOLS_CONFIG="${SMOLS_CONFIG:-$HOME/.config/small-model-skills/config}"
# shellcheck disable=SC1090
[ -r "$SMOLS_CONFIG" ] && . "$SMOLS_CONFIG"

: "${LOCAL_MODEL_DEFAULT:=qwen3-coder-cc}"

model="${CLAUDE_LOCAL_MODEL:-$LOCAL_MODEL_DEFAULT}"
case "${1:-}" in
  ""|-*) ;;                # no model arg, or first arg is a claude flag -> keep the default
  *) model="$1"; shift ;;  # first arg is the Ollama model tag
esac

# Curated-skills mode: point Claude Code at a config home that exposes ONLY the small-model-skills,
# not every user skill. A small model's tool-selection degrades as the skill/tool count grows, and each
# unused skill's description is dead weight in an already-tight context (Claude Code's own system prompt is
# ~27-30K tokens). install.sh builds this home. Opt out with SMOLS_CURATED_SKILLS=0. Falls back silently to
# the normal config if the home was never built.
# NOTE: this relocates CLAUDE_CONFIG_DIR to $CC_HOME, so global ~/.claude context — CLAUDE.md directives,
# custom agents/, and commands/ — does NOT load in curated mode. That is deliberate: a weak model does
# better with a small, clean context than with a full frontier-model setup. Use SMOLS_CURATED_SKILLS=0 to run
# against the full ~/.claude config instead.
CC_HOME="${SMOLS_CC_HOME:-$HOME/.config/small-model-skills/cc-home}"
cc_env=()
if [ "${SMOLS_CURATED_SKILLS:-1}" != 0 ] && [ -d "$CC_HOME/skills" ]; then
  cc_env=(CLAUDE_CONFIG_DIR="$CC_HOME")
fi

echo "claude-local: $model${cc_env:+  (curated skills)}" >&2
exec env \
  ${cc_env[@]+"${cc_env[@]}"} \
  ANTHROPIC_BASE_URL="http://localhost:11434" \
  ANTHROPIC_AUTH_TOKEN="ollama" \
  ANTHROPIC_API_KEY="" \
  ANTHROPIC_MODEL="$model" \
  ANTHROPIC_SMALL_FAST_MODEL="$model" \
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  claude --model "$model" "$@"
