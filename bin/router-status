#!/usr/bin/env bash
# router-status — read-only WAN/failover status: generic SNMP (IF-MIB) live signal + optional
# vendor module enrichment. Changes nothing on the router. Config-driven.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; . "$BIN_DIR/lib/common.sh"
GAP="${SW_SAMPLE_GAP:-2}"

sms_head "router-status"
have snmpwalk || { echo "  ERROR: net-snmp (snmpwalk) not installed"; exit 1; }
[ -n "$ROUTER_HOST" ] || { echo "  ERROR: no router host (set ROUTER_HOST or GATEWAY_IP in config)"; exit 1; }

declare -A NAME OPER IN1 IN2 OUT1 OUT2
snmpmap(){ snmpwalk -v2c -c "$SNMP_COMMUNITY" -Onq -t1 -r1 "$ROUTER_HOST" "$1" 2>/dev/null | while read -r oid val; do val=${val#\"}; val=${val%\"}; echo "${oid##*.} $val"; done; }
while read -r i v; do NAME[$i]="$v"; done < <(snmpmap 1.3.6.1.2.1.31.1.1.1.1)     # ifName
while read -r i v; do OPER[$i]="$v"; done < <(snmpmap 1.3.6.1.2.1.2.2.1.8)         # ifOperStatus
while read -r i v; do IN1[$i]="$v";  done < <(snmpmap 1.3.6.1.2.1.31.1.1.1.6)      # ifHCInOctets
while read -r i v; do OUT1[$i]="$v"; done < <(snmpmap 1.3.6.1.2.1.31.1.1.1.10)     # ifHCOutOctets
[ ${#NAME[@]} -gt 0 ] || { echo "  ERROR: no SNMP reply from $ROUTER_HOST (community '$SNMP_COMMUNITY'). Is SNMP enabled/reachable?"; exit 1; }
if [ "${GAP:-0}" -gt 0 ] 2>/dev/null; then sleep "$GAP"
  while read -r i v; do IN2[$i]="$v";  done < <(snmpmap 1.3.6.1.2.1.31.1.1.1.6)
  while read -r i v; do OUT2[$i]="$v"; done < <(snmpmap 1.3.6.1.2.1.31.1.1.1.10)
fi

opword(){ case "${1:-}" in 1) echo UP;; 2) echo DOWN;; *) echo "?";; esac; }
rate(){ local a="${1:-}" b="${2:-}"; { [ -z "$a" ] || [ -z "$b" ] || [ "${GAP:-0}" -le 0 ]; } 2>/dev/null && { echo "-"; return; }
  local d=$(( b - a )); [ "$d" -lt 0 ] && d=0; local s=$(( d / GAP ))
  if [ $s -ge 1048576 ]; then printf '%d MB/s' $((s/1048576)); elif [ $s -ge 1024 ]; then printf '%d KB/s' $((s/1024)); else printf '%d B/s' "$s"; fi; }

printf '  %-6s %-5s %-11s %-11s\n' IFACE LINK 'IN/s' 'OUT/s'
for i in $(for k in "${!NAME[@]}"; do echo "$k ${NAME[$k]}"; done | sort -k2 | awk '{print $1}'); do
  n="${NAME[$i]}"; st="$(opword "${OPER[$i]}")"
  if [ "$st" = DOWN ] && [ "$n" != "$WAN_PRIMARY" ] && [ "$n" != "$WAN_BACKUP" ] && [ "${IN1[$i]:-0}" = "0" ]; then continue; fi
  printf '  %-6s %-5s %-11s %-11s\n' "$n" "$st" "$(rate "${IN1[$i]:-}" "${IN2[$i]:-}")" "$(rate "${OUT1[$i]:-}" "${OUT2[$i]:-}")"
done

sms_sec "verdict"
p=""; s=""; for i in "${!NAME[@]}"; do [ "${NAME[$i]}" = "$WAN_PRIMARY" ] && p=$i; [ "${NAME[$i]}" = "$WAN_BACKUP" ] && s=$i; done
op=2; os=2; [ -n "$p" ] && op="${OPER[$p]:-2}"; [ -n "$s" ] && os="${OPER[$s]:-2}"
dp=0; ds=0
if [ "${GAP:-0}" -gt 0 ] 2>/dev/null; then [ -n "$p" ] && dp=$(( ${IN2[$p]:-0} - ${IN1[$p]:-0} )); [ -n "$s" ] && ds=$(( ${IN2[$s]:-0} - ${IN1[$s]:-0} )); fi
if [ -z "$p" ]; then
  echo "  (WAN_PRIMARY '${WAN_PRIMARY:-unset}' not found via SNMP — set WAN_PRIMARY/WAN_BACKUP in config; see table above)"
elif [ "$op" != 1 ] && [ "$os" != 1 ]; then
  echo "  BOTH WAN links DOWN ($WAN_PRIMARY $PRIMARY_ISP_LABEL + ${WAN_BACKUP:-none} $BACKUP_ISP_LABEL) -> total internet loss at the router."
elif [ "$op" != 1 ] && [ "$os" = 1 ]; then
  echo "  $WAN_PRIMARY ($PRIMARY_ISP_LABEL) DOWN, $WAN_BACKUP ($BACKUP_ISP_LABEL) UP -> FAILED OVER to backup."
elif [ "$op" = 1 ] && [ "${GAP:-0}" -gt 0 ] 2>/dev/null && [ -n "$s" ] && [ "$ds" -gt "$dp" ]; then
  echo "  $WAN_PRIMARY link up but traffic is on $WAN_BACKUP ($BACKUP_ISP_LABEL) -> likely LOGICAL failover."
elif [ "$op" = 1 ]; then
  echo "  $WAN_PRIMARY ($PRIMARY_ISP_LABEL) link UP$([ "${GAP:-0}" -gt 0 ] && echo ' and carrying traffic') -> normal path."
else
  echo "  Uncertain WAN state -> see table above."
fi

# vendor-specific enrichment (read-only)
if [ -n "$ROUTER_MODULE" ] && [ -f "$BIN_DIR/../modules/router/$ROUTER_MODULE.sh" ]; then
  # shellcheck disable=SC1090
  . "$BIN_DIR/../modules/router/$ROUTER_MODULE.sh"
  declare -f router_module_enrich >/dev/null && router_module_enrich
fi
