#!/usr/bin/env bash
# runaway-hunter — read-only hunt for aged + high-CPU, zombie/wedged, or known-offender processes (the
# classic freeze precursors) and PROPOSE the right kill. Runs nothing. Companion to system-triage: adds
# the AGE dimension + zombie/uninterruptible detection a one-shot snapshot lacks.
# Exit: 0 ran (even if it found something), 1 couldn't read the process table.
set -uo pipefail
BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"; . "$BIN_DIR/lib/common.sh"

smols_identity "Read-only: aged/high-CPU/zombie/known-offender processes + proposed kills (runs nothing)"

age_limit=$(( RUNAWAY_AGE_HOURS * 3600 ))
rows="$(smols_procs_aged)"
[ -n "$rows" ] || { smols_verdict FAIL PROBE_FAILED "could not read the process table"; exit 1; }
smols_line "thresholds" "cpu > ${RUNAWAY_CPU_PCT}%  AND  age > ${RUNAWAY_AGE_HOURS}h"

smols_sec "runaway candidates (high CPU AND aged)"
runaway="$(printf '%s\n' "$rows" | awk -v c="$RUNAWAY_CPU_PCT" -v a="$age_limit" '$3+0>c && $2+0>a')"
if [ -n "$runaway" ]; then
  printf '%s\n' "$runaway" | awk '{comm=$6; for(i=7;i<=NF;i++)comm=comm" "$i; h=int($2/3600); printf "%s,%s,%.0f%%,%.0f%%,%s,%sh\n",$1,comm,$3,$4,$5,h}' \
    | smols_toon runaway pid,comm,cpu,mem,stat,age
else
  echo "  (none — no process is both hot and long-running)"
fi

smols_sec "zombie / wedged (Z = defunct, D/U = uninterruptible)"
# state is the first char of stat: Z zombie; D (Linux) / U (macOS) uninterruptible
wedged="$(printf '%s\n' "$rows" | awk '{s=substr($5,1,1); comm=$6; for(i=7;i<=NF;i++)comm=comm" "$i} s=="Z"||s=="D"||s=="U" {printf "%s,%s,%s\n",$1,comm,$5}')"
if [ -n "$wedged" ]; then printf '%s\n' "$wedged" | smols_toon wedged pid,comm,stat; else echo "  (none)"; fi

# PERSISTENCE CHECK — a single ps snapshot can't tell a real wedge from load-driven churn.
# Under heavy fork/exit activity short-lived children flash through Z between exit and reap,
# and normal disk I/O parks a process in D for milliseconds — so an instantaneous count
# false-positives during busy periods. A REAL wedge PERSISTS: a parent that has stopped
# reaping keeps the SAME zombie pids for many seconds; a process stuck on a dead mount or
# driver stays in D/U the whole time. So we re-sample after RUNAWAY_WEDGE_RECHECK seconds
# and count a process as wedged only if the SAME pid is STILL wedged in the second sample.
# Churn collapses to ~0; a hung CIFS mount or a genuine reaping failure survives untouched.
# The re-sample runs ONLY when snapshot A already saw something, so healthy sweeps stay fast.
zpids_a="$(printf '%s\n' "$rows" | awk '{s=substr($5,1,1)} s=="Z"{print $1}')"
dpids_a="$(printf '%s\n' "$rows" | awk '{s=substr($5,1,1)} s=="D"||s=="U"{print $1}')"
zombie_inst=$(printf '%s\n' "$zpids_a" | awk 'NF{n++} END{print n+0}')
stuck_inst=$(printf '%s\n'  "$dpids_a" | awk 'NF{n++} END{print n+0}')
zombie_n=0; stuck_n=0
if [ -n "$zpids_a$dpids_a" ]; then
  sleep "$RUNAWAY_WEDGE_RECHECK"
  snapB="$(mktemp)"; ps -eo pid=,stat= > "$snapB" 2>/dev/null
  _persist() { # $1 = class (Z|DU); stdin = candidate pids from snapshot A; counts still-wedged in snapshot B
    awk -v cls="$1" 'NR==FNR { st[$1]=substr($2,1,1); next }
      { s=st[$1]; if (cls=="Z" && s=="Z") c++; else if (cls=="DU" && (s=="D"||s=="U")) c++ }
      END { print c+0 }' "$snapB" -
  }
  zombie_n=$(printf '%s\n' "$zpids_a" | _persist Z)
  stuck_n=$(printf '%s\n'  "$dpids_a" | _persist DU)
  rm -f "$snapB"
fi
alarm=""; { [ "$stuck_n" -gt 0 ] || [ "$zombie_n" -ge "$RUNAWAY_ZOMBIE_MAX" ]; } && alarm=1

offenders=""
pat="$(printf '%s' "$RUNAWAY_OFFENDERS" | xargs | tr ' ' '|')"
if [ -n "$pat" ]; then
  smols_sec "known offenders (from RUNAWAY_OFFENDERS)"
  offenders="$(printf '%s\n' "$rows" | awk -v p="$pat" '{comm=$6; for(i=7;i<=NF;i++)comm=comm" "$i} comm ~ p {h=int($2/3600); printf "%s,%s,%.0f%%,%sh\n",$1,comm,$3,h}')"
  if [ -n "$offenders" ]; then printf '%s\n' "$offenders" | smols_toon offenders pid,comm,cpu,age; else echo "  (none running)"; fi
fi

smols_sec "verdict"
if [ -n "$runaway" ]; then
  smols_verdict WARN RUNAWAY "a process is pegging a core for hours (a classic freeze precursor)."
  smols_help "Inspect first: 'ps -fp <pid>'. If safe to stop: 'kill <pid>', then only if it ignores that, 'kill -9 <pid>'. Never kill something mid-write."
elif [ -n "$offenders" ]; then
  smols_verdict WARN KNOWN_OFFENDER "one or more processes match your RUNAWAY_OFFENDERS watch-list; check their cpu/age in the offenders table above (they may be idle or short-lived) before deciding to kill."
  smols_help "Inspect first: 'ps -fp <pid>'. If it's genuinely stuck or hot, 'kill <pid>', then only if it ignores that, 'kill -9 <pid>'. Never kill something mid-write."
elif [ -n "$alarm" ]; then
  if [ "$stuck_n" -gt 0 ]; then
    smols_verdict WARN WEDGED "$stuck_n process(es) STILL uninterruptible (D/U) after ${RUNAWAY_WEDGE_RECHECK}s — a hung mount or stuck driver, not a momentary I/O wait."
  else
    smols_verdict WARN WEDGED "$zombie_n zombies persisted ${RUNAWAY_WEDGE_RECHECK}s (>= $RUNAWAY_ZOMBIE_MAX) — a parent has stopped reaping, not load-driven churn."
  fi
  smols_help "Zombies: inspect the PARENT ('ps -o ppid= -p <pid>' then 'ps -fp <ppid>') — reaping/restarting the parent clears them. Never 'kill -9' a D/U-state process; find what it's blocked on instead."
elif [ "$zombie_inst" -gt 0 ] || [ "$stuck_inst" -gt 0 ]; then
  smols_verdict OK NOMINAL "transient only — ${zombie_inst} zombie / ${stuck_inst} D-state seen, ${zombie_n} / ${stuck_n} still there after ${RUNAWAY_WEDGE_RECHECK}s (below WARN threshold); nothing hot-and-aged, no known offenders."
else
  smols_verdict OK NOMINAL "nothing hot-and-aged, no zombies, no known offenders. If it still feels slow, run system-triage or disk-report."
fi
exit 0
