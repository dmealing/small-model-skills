# never commit local credentials or a filled-in config
*.cred
/config
!/config.example
.DS_Store
*.swp

# local private denylist for the public-repo leak hooks (real names stay untracked)
.githooks/deny-list.local

# model weights — never commit these to a public repo (tens of GB, not authored content)
models/**/*.gguf

# model-bench: generated judge artifacts (regenerate via judge.py)
skills/model-bench/results.jsonl
skills/model-bench/gemini-judgments.json
skills/model-bench/gemini-judgments.jsonl
skills/model-bench/reasons-by-model.md

# Python bytecode (e.g. from running judge.py)
__pycache__/
*.pyc
