# never commit local credentials or a filled-in config
*.cred
/config
!/config.example
.DS_Store
*.swp

# local private denylist for the public-repo leak hooks (real names stay untracked)
.githooks/deny-list.local

# downloaded/converted model weights (tens of GB), the chat template install-model.sh downloads +
# patches at build time, and the download cache — never commit these to a public repo; they're
# regenerated locally by install-model.sh, not authored content
models/**/*.gguf
models/**/chat_template.jinja
models/**/.cache/
