# small-model-skills configuration.
# Copy to ~/.config/small-model-skills/config and edit. Sourced as shell (KEY=value, no spaces around =).
# Leave a value blank to auto-detect where possible. Never commit your filled-in copy.
#
# NOTE: smon (the routine system monitor in monitor/bin/) has its own separate config file:
# ~/.config/small-model-skills/monitor.conf — see monitor/monitor.conf.example for details.

# --- Network ---
GATEWAY_IP=                  # router/gateway LAN IP (blank = auto-detect from default route)
PRIMARY_NIC=                # main interface, e.g. eth0 / enp9s0 (blank = auto-detect)
DNS_LOCAL=                  # local DNS server (e.g. a Pi-hole); blank to skip that check
DNS_PUBLIC=1.1.1.1          # public resolver to compare against
DNS_PUBLIC2=9.9.9.9         # secondary public resolver

# --- WAN / failover (interface names AS THE ROUTER labels them, e.g. X1/X2, wan/wan2) ---
WAN_PRIMARY=                # primary ISP uplink, e.g. X1
WAN_BACKUP=                 # backup/failover uplink, e.g. X2 (blank if none)
PRIMARY_ISP_LABEL="primary ISP"
BACKUP_ISP_LABEL="backup link"

# --- Router module (deeper WAN/failover status; SNMP works without it) ---
ROUTER_MODULE=              # e.g. sonicwall (blank = generic SNMP only)
ROUTER_HOST=                # router mgmt IP (blank = GATEWAY_IP)
ROUTER_API_PORT=443         # vendor REST/mgmt port (SonicWall is often 443 or 8443)
SNMP_COMMUNITY=public       # SNMP v2c read community
ROUTER_CRED_ITEM=           # password-manager item for router admin creds (ONLINE only), e.g. op-get item name
# ROUTER_CRED_FILE=~/.config/small-model-skills/router.cred   # optional cached "user=.../pass=..." (chmod 600) for OFFLINE REST

# --- Local model (Ollama; used by the `claude-local` launcher) ---
LOCAL_MODEL_DEFAULT=qwen3-coder-cc # model claude-local uses with no arg. Any capable ~30B MoE coder works;
                                   # qwen3-coder-cc is the tested default — the num_ctx recipe built in models/.
# No 70B shortcut on purpose — a 70B local load is a real resource risk; pass the full tag explicitly.
# claude-local exposes ONLY this repo's skills by default (a curated CLAUDE_CONFIG_DIR home built by
# install.sh), which also means your global ~/.claude context does not load. Uncomment to opt out and use
# your full ~/.claude config instead. See docs/tuning-local-models.md.
# SMOLS_CURATED_SKILLS=0

# --- Diagnostics tuning (ollama-doctor / runaway-hunter / freeze-forensics) ---
OLLAMA_URL=http://localhost:11434   # ollama-doctor: local Ollama API base URL
RUNAWAY_CPU_PCT=50                  # runaway-hunter: flag processes above this %CPU ...
RUNAWAY_AGE_HOURS=4                 # ... AND running longer than this many hours
RUNAWAY_OFFENDERS=                  # extra comm/name patterns to always flag, space-separated (e.g. "bun pop-upgrade")
RUNAWAY_ZOMBIE_MAX=5                # ... and WARN on zombies only once this many pile up (a lone reapable zombie is ignored)
RUNAWAY_WEDGE_RECHECK=5             # ... re-checking wedged (Z / D-U) procs after N sec, WARNing only on ones that PERSIST (filters load churn)
SMOLS_NET_FSTYPES="cifs smb3 smbfs nfs nfs4 fuse.sshfs afpfs"   # disk-report: fs types treated as slow "network" mounts (probed separately, kept out of the local-capacity df)
SMOLS_NET_PROBE_TIMEOUT=5           # disk-report: per-network-mount reachability cap (s); a slower share is reported UNREACHABLE instead of hanging the probe
KNOWN_BAD_KERNELS=                  # freeze-forensics: kernel versions to warn about, space-separated (blank = none)
FREEZE_REMOTE_LOG_CMD=              # freeze-forensics: optional command to fetch a remote netconsole/black-box log.
                                    #   Host-specific; blank = off. Executed as code and hard-capped at 10s, but the
                                    #   command should ALSO set its own low timeout, e.g.:
                                    #   ssh -o ConnectTimeout=5 loghost 'tail -50 /var/log/popos-netconsole.log'

# --- Verdict thresholds (the WARN/FAIL a wrapper reports; each host can tune) ---
# DISK_WARN_PCT=85      # disk-report WARN (DISK_HIGH) at/above this % on the fullest filesystem
# DISK_CRIT_PCT=95      # disk-report FAIL (DISK_CRITICAL) at/above this %
# LOAD_WARN_FACTOR=1.5  # sys-diag WARN (HIGH_LOAD) when 1-min load > cores * this factor
# CPU_HOG_PCT=90        # sys-diag WARN (CPU_HOG) when a single process uses >= this %core
# SWAP_WARN_KB=1048576  # sys-diag WARN (MEMORY_PRESSURE) when swap-in-use exceeds this many KiB
# TEMP_WARN_C=85        # sys-diag WARN (THERMAL) when the hottest CPU/GPU sensor is >= this °C
# SMART_NVME_WEAR_WARN=80    # smart-health WARN (DRIVE_AGING) when NVMe 'Percentage Used' >= this %
# SMART_NVME_WEAR_CRIT=95    # smart-health FAIL (DRIVE_FAILING) when NVMe 'Percentage Used' >= this %
# SMART_SPARE_WARN=20        # smart-health WARN (DRIVE_AGING) when NVMe 'Available Spare' <= this %
# SMART_TEMP_WARN=70         # smart-health WARN (DRIVE_AGING) when any drive temp >= this °C
# SMART_DEVICES=             # smart-health device list (blank = auto-detect physical disks via lsblk)
# WAN_HEALTH_STATUS=         # wan-health: path to the wan-link-supervisor's status.json (blank = ${XDG_STATE_HOME:-$HOME/.local/state}/wanlink/status.json; the private supervisor writes it)
# WAN_HEALTH_MAX_AGE_S=30    # wan-health FAIL (WAN_PROBE_FAILED) when status.json ts is older than this (s); ~2x the supervisor's ~15s cycle (raw age is compared, so 30.4s still trips)

# --- File search (file-search skill / find-files) ---
SEARCH_ROOT=            # default dir to search when none is given (blank = current dir; e.g. set to $HOME)
SEARCH_MAX=20           # cap results per section (names / contents)
# SEARCH_NAME_TIMEOUT=15    # seconds before the file-NAME search is cut off (verdict says so; raise to try harder)
# SEARCH_CONTENT_TIMEOUT=20 # seconds before the file-CONTENT search is cut off

# --- Disk report (disk-report skill) ---
# SMOLS_DU_TIMEOUT=20       # seconds to spend sizing the biggest dirs one level under the fullest filesystem
# SMOLS_DU_HOG_TIMEOUT=8    # seconds per common hog dir (/var/log, ~/.cache, /var/cache, /tmp)
# SMOLS_DOCKER_TIMEOUT=8    # seconds for 'docker system df' (bounded so a wedged daemon can't hang the report)
